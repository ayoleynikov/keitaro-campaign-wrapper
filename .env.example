# Backend (safe defaults: mock mode, no secrets)
DATABASE_URL=sqlite:///./data/app.db
KEITARO_MODE=mock
KEITARO_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# Live mode — fill in locally, never commit a real key or tracker host.
# KEITARO_MODE=live
# KEITARO_BASE_URL=https://your-tracker.example
# KEITARO_API_KEY=
# Optional: require HTTPS and same-origin redirects for the Admin API client.
# KEITARO_ALLOWED_ORIGIN=https://your-tracker.example

# Optional write guards (all off/empty by default; set only when you need them)
# KEITARO_WRITE_ALLOWLIST_NAME=exact_campaign_name_allowed_to_write
# KEITARO_DISABLE_COMPENSATION=false
# KEITARO_FORBID_DELETE=false
# KEITARO_CREATE_CAMPAIGN_STATE=active

# Docker compose overrides
BACKEND_PORT=8801
